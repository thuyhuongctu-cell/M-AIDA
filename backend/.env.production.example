# Copy to a host-only backend env file and replace placeholders.
# This file is an example only; never commit populated secrets.

LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# Optional external synchronization. Leave blank when not approved.
NOTION_TOKEN=
NOTION_DATABASE_ID=

MAIDA_PORT=8765
MAIDA_DB_PATH=/data/maida.db
MAIDA_DEMO_MODE=false

# Use the exact HTTPS pilot origin. Keep this as a JSON list and never use "*".
CORS_ORIGINS=["https://research-staging.example.edu"]
