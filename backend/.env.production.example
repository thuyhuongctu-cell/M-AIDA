# ── M-AIDA backend — PRODUCTION / PRIVATE STAGING environment ──────────────
# Copy to a host-only backend env file and fill in real values.
# NEVER commit the populated file (backend/.env and host secret paths are ignored).

# LLM provider (vendor-neutral adapter). Required only for live PDF extraction;
# without a key the /api/extract endpoint returns an explicit 503 and every
# other feature (verify, lock, export, forest data) keeps working.
LLM_PROVIDER=anthropic
LLM_API_KEY=                 # provider key (SECRET — set only on the host)
LLM_MODEL=                   # approved model id

# Optional Notion sync (leave blank until external synchronization is approved).
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Server
MAIDA_PORT=8765

# CORS must be a JSON list containing the exact HTTPS browser origin. Even when
# nginx proxies /api/ on the same host, keeping an explicit origin prevents the
# backend from being reused by an unapproved site. Never use "*" for the pilot.
CORS_ORIGINS=["https://research-staging.example.edu"]

# Persist the study store on a mounted volume, never inside the container layer.
# docker-compose.web-staging.yml forces this same path at runtime.
MAIDA_DB_PATH=/data/maida.db

# Demo behaviours must stay off wherever real or pilot research data is stored.
MAIDA_DEMO_MODE=false
