{$WEB_STAGING_DOMAIN} {
    encode zstd gzip

    # Private-pilot boundary. Caddy requires a hashed password; generate it
    # with: docker run --rm caddy:2-alpine caddy hash-password --plaintext '...'
    basic_auth {
        {$WEB_STAGING_BASIC_AUTH_USER} {$WEB_STAGING_BASIC_AUTH_HASH}
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    reverse_proxy frontend:3000
}
