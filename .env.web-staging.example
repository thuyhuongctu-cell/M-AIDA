# Copy to a host-only file, for example /srv/maida-staging/web-staging.env.
# Never commit the populated file.

WEB_STAGING_DOMAIN=research-staging.example.edu
WEB_STAGING_BASIC_AUTH_USER=researcher
# Generate with:
# docker run --rm caddy:2-alpine caddy hash-password --plaintext 'choose-a-strong-password'
WEB_STAGING_BASIC_AUTH_HASH='$2a$14$replace_with_caddy_hash'

# Absolute durable path. The database will be stored as maida.db inside it.
MAIDA_DATA_DIR=/srv/maida-staging/data
MAIDA_BACKEND_ENV_FILE=/srv/maida-staging/secrets/backend.env

VITE_APP_VERSION=7.2.0-rc.1
VITE_PRIVACY_POLICY_URL=https://thuyhuongctu.github.io/M-AIDA/app-privacy.html
VITE_SUPPORT_URL=https://thuyhuongctu.github.io/M-AIDA/app-support.html
